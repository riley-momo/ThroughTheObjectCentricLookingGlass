%% ===================================================================
%% Process mereotopology: shared axioms (paper, Section 4)
%%
%% Encoding conventions
%%   * Axiom SCHEMATA over object types T, T1, T2 and activities a are
%%     made first-order by reifying types and activities as individuals:
%%     T(x) becomes ty(x) = t, and "T in B_D" becomes ibt(d,t).
%%   * Everything that depends on a domain theory D carries a theory
%%     index d, so that results comparing theories (D below D') can be
%%     stated in one signature.  det_T is NOT indexed: as in the paper it
%%     is defined per type, independently of the theory.
%%
%% Signature
%%   occurrence(x)        x is an activity occurrence
%%   occurrence_of(e,a)   e is an occurrence of activity a
%%   object(x)            x is an object
%%   ty(x)                the (unique) type of object x      [T(x) iff ty(x)=T]
%%   participates(x,e)    object x participates in occurrence e
%%   part(x,y)            x is part of y
%%   conn(x,y)            x is connected to y                 [C]
%%   sum(x,y,z)           z is the sum of x and y
%%   event(x), atomic(x), cplx(x)   atomic / complex occurrences
%%   det(t,e)             e is determinate for type t          [det_T(e)]
%%
%%   ibt(d,t)             t is identity-bearing in D           [t in B_D]
%%   ib(d,x)              x is an object of an identity-bearing type [x in O_D]
%%   decl(d,t1,t2)        TypeConn(t1,t2) is declared in D
%%   decla(d,t1,t2,a)     ActConn(t1,t2,a) is declared in D
%%   nodet(d)             D's Fuse instances drop determinacy (Fuse^0, used
%%                        only for the connected-components theory D_CC)
%%   app(d,t1,t2,e)       some declared (possibly activity-restricted) Fuse
%%                        instance for (t1,t2) applies at e
%%   fp(d,x,y)            x,y are identified by an instance of (Fuse) in D
%%   sg(d,x)              the whole generated by x in D        [sigma(x)]
%%   sim(d,x,y)           x ~_D y : the least equivalence on O_D containing fp
%%   leq(d,d2)            D is below D2                        [D below D']
%%
%% Leastness (Section 4.3: "we take the least assignment satisfying them").
%% Leastness is second-order; we use it as two FIRST-ORDER SCHEMATA, one
%% instance per relation P(x,y) needed, written out in the goal file that
%% uses it (like instances of an induction schema):
%%
%%  (Least_sim[P])  if P is reflexive on O_D, symmetric, transitive and
%%                  contains fp(d,-,-), then sim(d,x,y) -> P(x,y).
%%  (Least_sg[P])   if P is reflexive on O_D, symmetric, transitive and
%%                  contains fp(d,-,-), then for x,y in O_D,
%%                  sg(d,x) = sg(d,y) -> P(x,y).
%%
%% Least_sim says ~_D is the least such equivalence (Notation, Section 5);
%% Least_sg says sigma identifies no more objects than (Fuse) forces.
%% ===================================================================

formulas(assumptions).

  %% ---------------- Signature of the log (Section 4) -----------------
  all x all e (participates(x,e) -> object(x) & occurrence(e)).
  all e all a (occurrence_of(e,a) -> occurrence(e)).
  % Objects and occurrences are distinct sorts.
  all x (object(x) -> -occurrence(x)).
  % Domain closure and pairwise disjointness of types are built into ty
  % being a function: every object has exactly one type.

  %% ---------------- Ground mereology (Section 4.1) -------------------
  all x part(x,x).                                             % reflexivity
  all x all y (part(x,y) & part(y,x) -> x = y).                % antisymmetry
  all x all y all z (part(x,y) & part(y,z) -> part(x,z)).      % transitivity

  all x (atomic(x) <-> (all y (part(y,x) -> y = x))).          % atomic_part
  all x (event(x) <-> occurrence(x) & atomic(x)).              % events
  all x (cplx(x) <-> (exists y (part(y,x) & y != x))).         % complex

  %% ---------------- Connection --------------------------------------
  all x conn(x,x).                                             % reflexivity
  all x all y (conn(x,y) -> conn(y,x)).                        % symmetry

  % (Mono)
  all x all y (part(x,y) -> (all z (conn(z,x) -> conn(z,y)))).
  % sums have their summands as parts
  all x all y all z (sum(x,y,z) -> part(x,z) & part(y,z)).
  % (SumC)
  all x all y all s
    (sum(x,y,s) -> (all u (conn(u,s) <-> conn(u,x) | conn(u,y)))).
  % (Sum->C), deliberately one-directional
  all x all y ((exists s sum(x,y,s)) -> conn(x,y)).
  % (SumU)
  all x all y all s1 all s2 (sum(x,y,s1) & sum(x,y,s2) -> s1 = s2).

  %% ---------------- Domain theory vocabulary -------------------------
  all d all x (ib(d,x) <-> object(x) & ibt(d,ty(x))).

  all d all t1 all t2 all e
    (app(d,t1,t2,e) <->
       decl(d,t1,t2) | (exists a (decla(d,t1,t2,a) & occurrence_of(e,a)))).

  %% ---------------- Connection schemata (Section 4.2) ----------------
  % (IdConn(T)) for every T in B_D
  all d all x all e1 all e2
    ((ib(d,x) & participates(x,e1) & participates(x,e2)) -> conn(e1,e2)).

  % (TypeConn(T1,T2)) and (ActConn(T1,T2,a)): the co-participation
  % witnesses o1, o2, eco are universally quantified over the implication
  % (equivalently, existentially quantified inside the antecedent).
  all d all e1 all e2 all o1 all o2 all eco
    ((app(d,ty(o1),ty(o2),eco)
      & participates(o1,eco) & participates(o2,eco)
      & participates(o1,e1) & participates(o2,e2) & e1 != e2)
       -> conn(e1,e2)).

  %% ---------------- Domain conditions on sums (Section 4.3) ----------
  % (Det)
  all t all e
    (det(t,e) <->
       (all x all y ((ty(x) = t & participates(x,e) &
                      ty(y) = t & participates(y,e)) -> x = y))).

  % Pairs identified by a (Fuse(T1,T2)) / (Fuse_a(T1,T2)) instance of D,
  % or by a (Fuse^0) instance when D drops determinacy (D_CC, Section 5.2).
  all d all x all y
    (fp(d,x,y) <->
       ib(d,x) & ib(d,y) &
       (exists e (participates(x,e) & participates(y,e)
                  & app(d,ty(x),ty(y),e)
                  & (nodet(d) | (det(ty(x),e) & det(ty(y),e)))))).

  % (Fuse)
  all d all x all y (fp(d,x,y) -> sg(d,x) = sg(d,y)).

  % (Sum(T)) for every T in B_D.  The witness o' ranges over O_D, since
  % sigma is only defined on identity-bearing objects.
  all d all o all e
    ((ib(d,o) & event(e)) ->
       (part(e,sg(d,o)) <->
          (exists o2 (ib(d,o2) & sg(d,o2) = sg(d,o) & participates(o2,e))))).

  % (Only) is relativized to one theory's model, so it is not asserted
  % here: in a signature holding several theories at once it would force
  % every whole of D to also be a whole of D'.  No Section 5 result uses it.

  %% ---------------- ~_D (Notation, Section 5) ------------------------
  all d all x all y (sim(d,x,y) -> ib(d,x) & ib(d,y)).
  all d all x (ib(d,x) -> sim(d,x,x)).
  all d all x all y (sim(d,x,y) -> sim(d,y,x)).
  all d all x all y all z (sim(d,x,y) & sim(d,y,z) -> sim(d,x,z)).
  all d all x all y (fp(d,x,y) -> sim(d,x,y)).

  %% ---------------- D below D' (Notation, Section 5) -----------------
  all d all d2
    (leq(d,d2) <->
       (all t (ibt(d,t) -> ibt(d2,t))) &
       (all t1 all t2 (decl(d,t1,t2) -> decl(d2,t1,t2))) &
       (all t1 all t2 all a (decla(d,t1,t2,a) -> decla(d2,t1,t2,a))) &
       (nodet(d) -> nodet(d2))).

  %% ---------------- Definitions of Section 5.1 -----------------------
  % Deficient(e) : e is part of no whole of D
  all d all e (deficient(d,e) <-> -(exists z (ib(d,z) & part(e,sg(d,z))))).

  % Convergent(e) : e is part of two distinct wholes of D
  all d all e
    (convergent(d,e) <->
       (exists x exists y (ib(d,x) & ib(d,y) & part(e,sg(d,x)) &
                           part(e,sg(d,y)) & sg(d,x) != sg(d,y)))).

  % Definition 1 (Divergence): D diverges from the intended theory D*
  all d all ds
    (diverges(d,ds) <->
       (exists x exists y (ib(d,x) & ib(d,y) & ib(ds,x) & ib(ds,y) &
                           sim(d,x,y) & -sim(ds,x,y)))).

end_of_list.
