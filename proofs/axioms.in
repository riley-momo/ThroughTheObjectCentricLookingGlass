%% ---------------------------------------------------------------
%% Process mereotopology: shared axioms
%%
%% Signature
%%   event(x)            x is an atomic activity occurrence (log event)
%%   cplx(x)             x is a complex activity occurrence
%%   ib(x)               x is an object of a declared identity-bearing type
%%                       (stands for the disjunction over T in B)
%%   participates(x,y)   object x participates in occurrence y
%%   part(x,y)           x is part of y
%%   conn(x,y)           x is connected to y            [C in the paper]
%%   sum(x,y,z)          z is the sum of x and y
%%   sg(x)               the whole generated by x       [sigma in the paper]
%%   det(x,y)            event y is determinate for x's type   [det_T(e)]
%%   decl(x,y)           the types of x and y are a declared pair  [in D]
%%
%% ---------------------------------------------------------------

formulas(assumptions).

   % Ground mereology
  all x part(x,x).                                            % reflexivity
  all x all y (part(x,y) & part(y,x) -> x = y).               % antisymmetry
  all x all y all z (part(x,y) & part(y,z) -> part(x,z)).     % transitivity

  all x (cplx(x) <-> exists y (part(y,x) & y != x)).          % complex occ definition

  % Connection (simple topological relation)
  all x conn(x,x).                                            % reflexivity
  all x all y (conn(x,y) -> conn(y,x)).                       % symmetry

  % (Mono) a whole is connected to whatever its parts are connected to
  all x all y (part(x,y) -> (all z (conn(z,x) -> conn(z,y)))).

  % Sums
  all x all y all z (sum(x,y,z) -> part(x,z) & part(y,z)).

  % (SumC)
  all x all y all z
    (sum(x,y,z) -> (all u (conn(u,z) <-> (conn(u,x) | conn(u,y))))).

  % (Sum->C)  one-directional
  all x all y ((exists z sum(x,y,z)) -> conn(x,y)).

  % (SumU)
  all x all y all z all u (sum(x,y,z) & sum(x,y,u) -> z = u).

  % Domain conditions on sums ---------------------------------------
  % (Sum(T)), with the witness restricted to identity-bearing objects
  all x all y
    ((ib(x) & event(y)) ->
      (part(y,sg(x)) <-> exists z (ib(z) & sg(z) = sg(x) & participates(z,y)))).

  % (Fuse(T1,T2))
  all x all y all z
    ((ib(x) & ib(y) & decl(x,y) &
      participates(x,z) & participates(y,z) &
      det(x,z) & det(y,z)) -> sg(x) = sg(y)).

  % (Only)
  all x (cplx(x) -> exists y (ib(y) & x = sg(y))).

  % Flatness Lemma (since we cannot derive this as a consequence of leastness in FOL)
  all x all y ((ib(x) & ib(y) & part(sg(x),sg(y))) -> sg(x) = sg(y)).

end_of_list.
