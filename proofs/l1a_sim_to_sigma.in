%% Lemma 1, first part, direction <-.  For o1,o2 in O_D:
%%   o1 ~_D o2  ->  sigma(o1) = sigma(o2).
%% [(Fuse) gives every generating pair; Least_sim with P(x,y) := sg(d,x) = sg(d,y).]
formulas(assumptions).
  % Least_sim[ sg(d,x) = sg(d,y) ]
  all d (( (all x (ib(d,x) -> sg(d,x) = sg(d,x))) &
           (all x all y (sg(d,x) = sg(d,y) -> sg(d,y) = sg(d,x))) &
           (all x all y all z (sg(d,x) = sg(d,y) & sg(d,y) = sg(d,z) -> sg(d,x) = sg(d,z))) &
           (all x all y (fp(d,x,y) -> sg(d,x) = sg(d,y))) )
         -> (all x all y (sim(d,x,y) -> sg(d,x) = sg(d,y)))).
end_of_list.
formulas(goals).
  all d all x all y (sim(d,x,y) -> sg(d,x) = sg(d,y)).
end_of_list.
